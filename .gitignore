/.bundle/
/.yardoc
/_yardoc/
/coverage/
/doc/
/pkg/
/spec/reports/
/spec/examples.txt
# Per-worker example-status files written by parallel_tests (spec/examples.2.txt, ...).
/spec/examples.*.txt
/tmp/

# Binary document fixtures (xlsx/docx/pdf) are regenerated deterministically
# from spec/support/document_fixtures.rb in a before(:suite) hook; the OOXML
# zip writer emits non-deterministic bytes (timestamps), so committing them
# would dirty the working tree on every run. The text fixtures stay committed.
/spec/fixtures/documents/*.xlsx
/spec/fixtures/documents/*.docx
/spec/fixtures/documents/*.pdf
*.gem
Gemfile.lock

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets
.env
*.env.local
:memory:

:memory:*

# Runtime agent state written into the cwd. Authored/distilled skills now go to
# the agent HOME (RUBINO_HOME → ~/.rubino), never the project tree (SK-1), but
# ignore .rubino/ defensively so a runtime-written skill can never be committed
# into a user's repo again.
/.rubino/

# Claude Code local state (skills, transient agent worktrees)
.claude/

# Eval harness: raw per-run result JSON is generated output, not source.
# Keep the directory (via .gitkeep) but ignore the timestamped result files.
/eval/results/*.json

# generated A/B eval result dumps (keep .gitkeep + .md analyses)
eval/results/*.json

# Kept local, never tracked/pushed/shipped (user directive)
AGENTS.md
docs/agents.md
